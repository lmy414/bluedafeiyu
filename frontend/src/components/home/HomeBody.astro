---
import {archiveContext} from '../../lib/archive.mjs';
import {orderWorks} from '../../../public/components/work-order.js';
import {renderHomeCard} from './HomeCard.mjs';
import HomeFilter from './HomeFilter.astro';
const {galleryWorks,chars,topics,serialWorkIds}=archiveContext;
const latest=orderWorks(galleryWorks).slice(0,30);
const cards=latest.map((work,index)=>renderHomeCard(work,{eager:index<5,priority:index===0})).join('');
---

<div class="app" id="app">
  <aside class="sidebar" aria-label="站点导航" data-i18n-attr="aria-label:d.home.nav">
    <div class="brand">
      <a class="brand-mark" href="/" aria-label="蓝色大肥鱼首页" data-i18n-attr="aria-label:d.home.homeLabel"><img src="/avatar.png" width="40" height="40" alt="蓝色大肥鱼" data-i18n-attr="alt:d.home.brand" decoding="async"></a>
      <a class="brand-text" href="/">
        <div class="brand-name" data-i18n="d.home.brand">蓝色大肥鱼</div>
        <div class="brand-sub" data-i18n="d.home.brandSub">AI 娘同人档案</div>
      </a>
      <button class="collapse" id="collapse" type="button" aria-label="收起侧栏" data-i18n-attr="aria-label:d.home.collapse" aria-expanded="true"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m16 15-3-3 3-3"/></svg></button>
    </div>
    <nav class="nav-section" aria-label="图片与角色" data-i18n-attr="aria-label:d.home.imagesRoles">
      <div class="nav-label" data-i18n="d.home.imagesRoles">图片与角色</div>
      <a aria-label="全部图片" data-i18n-attr="aria-label:d.home.allImages" aria-current="page" class="nav-item is-active" href="/"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M18 22H4a2 2 0 0 1-2-2V6"/><path d="m22 13-1.296-1.296a2.41 2.41 0 0 0-3.408 0L11 18"/><circle cx="12" cy="8" r="2"/><rect width="16" height="16" x="6" y="2" rx="2"/></svg><span data-i18n="d.home.allImages">全部图片</span></a>
<a aria-label="角色百科" data-i18n-attr="aria-label:d.home.characters" class="nav-item" href="/characters.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg><span data-i18n="d.home.characters">角色百科</span></a>
<a aria-label="主题合集" data-i18n-attr="aria-label:d.home.topics" class="nav-item" href="/topics.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg><span data-i18n="d.home.topics">主题合集</span></a>
<a aria-label="连载漫画" data-i18n-attr="aria-label:d.home.serials" class="nav-item" href="/serials.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg><span data-i18n="d.home.serials">连载漫画</span></a>
<a aria-label="视频" data-i18n-attr="aria-label:d.home.videos" class="nav-item" href="/videos.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg><span data-i18n="d.home.videos">视频</span></a>
<a aria-label="创作者" data-i18n-attr="aria-label:d.home.creators" class="nav-item" href="/creators.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg><span data-i18n="d.home.creators">创作者</span></a>
    </nav>
    <nav class="nav-section" aria-label="我的与社区" data-i18n-attr="aria-label:d.home.communityLabel">
      <div class="nav-label" data-i18n="d.home.communityLabel">我的与社区</div>
      <a aria-label="社区项目" data-i18n-attr="aria-label:d.home.projects" class="nav-item" href="/community-projects.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><rect width="7" height="7" x="14" y="3" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/></svg><span data-i18n="d.home.projects">社区项目</span></a>
<a aria-label="站点活动" data-i18n-attr="aria-label:d.home.events" class="nav-item" href="/events.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg><span data-i18n="d.home.events">站点活动</span></a>
<a aria-label="加入社群" data-i18n-attr="aria-label:d.home.join" class="nav-item" href="/community.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg><span data-i18n="d.home.join">加入社群</span></a>
<a aria-label="友情链接" data-i18n-attr="aria-label:d.home.friends" class="nav-item" href="/friend-links.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span data-i18n="d.home.friends">友情链接</span></a>
    </nav>
    <div class="sidebar-spacer" aria-hidden="true"></div>
    <hr>
    <div class="sidebar-links"><a href="/about.html" data-i18n="d.home.about">关于</a><a href="/changelog.html" data-i18n="d.home.log">日志</a></div>
    <a aria-label="投稿" data-i18n-attr="aria-label:d.home.submit" class="cta" href="/submit.html"><span data-i18n="d.home.submit">投稿</span><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg></a>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="mobile-menu" id="menu" type="button" aria-label="打开导航" data-i18n-attr="aria-label:d.home.openNav" aria-expanded="false"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m16 15-3-3 3-3"/></svg></button>
      <form class="search" action="/search.html" method="get" role="search">
        <svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" name="q" placeholder="搜索图片、角色或创作者" aria-label="搜索图片、角色或创作者" data-i18n-attr="placeholder:d.home.search,aria-label:d.home.search">
        <span class="kbd">⌘ K</span>
      </form>
      <div class="actions">
        <a class="btn" href="/community.html" aria-label="加入社群" data-i18n-attr="aria-label:d.home.join"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg><span class="btn-label" data-i18n="d.home.join">加入社群</span></a>
        <a class="btn btn-primary" href="/submit.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg><span class="btn-label" data-i18n="d.home.submit">投稿</span></a>
        <button class="btn icon-btn" id="theme" data-theme-toggle type="button" aria-label="切换深色模式" data-i18n-attr="aria-label:d.home.themeLabel"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.9 4.9 1.4 1.4"/><path d="m17.7 17.7 1.4 1.4"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.3 17.7-1.4 1.4"/><path d="m19.1 4.9-1.4 1.4"/></svg></button>
        <div class="lang-picker" id="language-picker">
<button class="lang lang-trigger" id="lang" type="button" aria-label="切换语言，当前简体中文" aria-haspopup="listbox" aria-expanded="false" aria-controls="language-options"><span>简中</span><svg class="icon lang-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
<ul class="lang-panel lang-menu" id="language-options" role="listbox" aria-label="页面语言" hidden>
<li class="lang-option" role="option" aria-selected="true" data-value="zh-CN" tabindex="-1"><span>简体中文</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
<li class="lang-option" role="option" aria-selected="false" data-value="zh-TW" tabindex="-1"><span>繁體中文</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
<li class="lang-option" role="option" aria-selected="false" data-value="en" tabindex="-1"><span>English</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
<li class="lang-option" role="option" aria-selected="false" data-value="ja" tabindex="-1"><span>日本語</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
</ul><span class="sr-only" role="status" id="language-status"></span>
</div>
      </div>
    </header>

    <main class="content" id="main">
      <section class="hero">
        <div class="hero-copy">
          <div class="eyebrow"><span>AI GIRL ARCHIVE</span><i></i></div>
          <h1 data-i18n="d.home.hero">蓝色大肥鱼 · DeepSeek娘（大肥鱼） 表情包与二创档案</h1>
          <p class="hero-sub" data-i18n="d.home.heroSub">蓝色大肥鱼 · AI 娘的图片、影像与角色档案。</p>
        </div>
        <aside class="stats" aria-label="站点数据" data-i18n-attr="aria-label:d.home.stats">
          <div class="stats-kicker" data-i18n="d.home.collect">一起收好有趣的创作</div>
          <div class="stats-row">
            <div class="stat"><b>{galleryWorks.length}</b><span data-i18n="d.home.imageArchive">图片图库</span></div>
            <div class="stat"><b>{chars.length}</b><span data-i18n="d.home.roleArchive">角色图鉴</span></div>
            <div class="stat"><b>{topics.length}</b><span data-i18n="d.home.topics">主题合集</span></div>
          </div>
          <div class="stats-note" data-i18n="d.home.rights">作品版权归原作者所有</div>
        </aside>
      </section>

      <section aria-labelledby="gallery-title">
        <div class="section-head"><h2 id="gallery-title" data-i18n="d.home.allImages">全部图片</h2><span data-home-count aria-live="polite" data-i18n-tpl="d.home.imageCount" data-i18n-vars={JSON.stringify({count:galleryWorks.length.toLocaleString("en-US")})}>{galleryWorks.length.toLocaleString("en-US")} 张图片</span></div>
        <div class="filters">
          <div class="chips"><a class="chip is-active" data-home-type="" href="/browse.html" data-i18n="d.home.all">全部</a>
<a class="chip" data-home-type="meme" href="/categories/meme.html" data-i18n="d.home.meme">梗图</a>
<a class="chip" data-home-type="illustration" href="/categories/illustration.html" data-i18n="d.home.illustration">插画</a>
<a class="chip" data-home-type="setting" href="/categories/setting.html" data-i18n="d.home.setting">设定图</a>
<a class="chip" data-home-type="comic" href="/categories/comic.html" data-i18n="d.home.comic">漫画</a>
<a class="chip" data-home-type="standing" href="/categories/standing.html" data-i18n="d.home.standing">立绘</a>
<a class="chip" data-home-type="other" href="/categories/other.html" data-i18n="d.home.other">其他</a>
<a class="chip" data-home-type="gif" href="/gifs.html">GIF</a>
<HomeFilter name="character" label="全部角色" labelKey="d.allRoles" options={[{name:"全部角色",key:"d.allRoles",href:"/browse.html"},...chars.map(c=>({name:c.name,character:c.id,href:"/browse.html#character="+c.id}))]} /></div>
          <div class="filter-actions">
            <div class="lang-picker filter-picker" data-filter-picker="sort"><button type="button" class="action lang-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="sort-options"><span data-i18n="d.home.latest">最新收录</span><svg class="icon lang-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><ul class="lang-panel" role="listbox" aria-label="最新收录" data-i18n-attr="aria-label:d.home.latest" id="sort-options" hidden><li class="lang-option" role="option" aria-selected="true" tabindex="-1" data-href="/browse.html#sort=latest" data-i18n="d.home.latest">最新收录</li><li class="lang-option" role="option" aria-selected="false" tabindex="-1" data-href="/browse.html#sort=random" data-i18n="d.home.random">随机浏览</li></ul></div>
            <a class="action" data-home-reset href="/browse.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg><span data-i18n="d.clear">清除条件</span></a>
          </div>
        </div>
        <p data-home-empty hidden data-i18n="d.noResults">还没找到合适的作品。</p>
        <div class="masonry" data-feed-grid data-excluded-ids={JSON.stringify([...serialWorkIds])}><Fragment set:html={cards} /></div>
<div class="loadmore">
          <span data-home-shown data-i18n-tpl="d.home.shown" data-i18n-vars={JSON.stringify({shown:latest.length,total:galleryWorks.length.toLocaleString("en-US")})}>已展示 {latest.length} / {galleryWorks.length.toLocaleString("en-US")} 张</span>
          <a data-home-more href="/browse.html"><span data-i18n="d.loadMore">加载更多</span> <svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
        </div>
      </section>

      <section class="guide" aria-labelledby="guide-title">
        <div class="guide-card">
          <div class="guide-title"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg><span id="guide-title" data-i18n="d.home.guide">第一次来，怎样找到想要的图?</span></div>
          <div class="rule"></div>
          <div class="guide-grid">
            <div>
              <h3 data-i18n="d.home.byRole">按角色和类型找</h3>
              <p data-i18n="d.home.roleGuide">本站收录社区创作的 AI 娘表情包、插画、立绘设定与漫画。先选择角色，再按作品类型浏览；想找具体台词或情绪找图，可以使用搜索。</p>
              <div class="pills">
<a class="pill" href="/characters/deepseek.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="icon-label" data-i18n="d.home.roleDeepSeek">DeepSeek娘表情包与二创</span><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
<a class="pill" href="/characters/claude.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="icon-label" data-i18n="d.home.roleClaude">Claude娘表情包与二创</span><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
<a class="pill" href="/characters/gpt.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="icon-label" data-i18n="d.home.roleGPT">GPT娘表情包与二创</span><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
<a class="pill" href="/characters/gemini.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="icon-label" data-i18n="d.home.roleGemini">Gemini娘表情包与二创</span><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
<a class="pill" href="/characters/grok.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="icon-label" data-i18n="d.home.roleGrok">Grok娘表情包与二创</span><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
              </div>
            </div>
            <div>
              <h3 data-i18n="d.home.byTopic">按主题连着看</h3>
              <p data-i18n="d.home.topicGuide">作者作品集保留投稿者的作品线索。日常场景选题把一组相关作品串起来，作品来源与授权仍保留在每张作品详情中。</p>
              <a class="guide-link" href="/creators.html" data-i18n="d.home.browseTopics">浏览作者作品集与主题合集</a>
            </div>
          </div>
          <div class="rule"></div>
          <details class="faq" open>
            <summary><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg><span data-i18n="d.home.relationship">蓝色大肥鱼与 DeepSeek娘是什么关系?</span></summary>
            <p data-i18n="d.home.relationshipAnswer">本站角色记录将“蓝色大肥鱼”和“鲸鱼娘”列为 DeepSeek娘的别名。本网站是非官方同人整理项目；这里收录的是社区二创，各作品来源请查看详情。</p>
          </details>
          <div class="rule"></div>
          <details class="faq" open>
            <summary><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg><span data-i18n="d.home.download">怎样下载原图并确认使用范围?</span></summary>
            <p data-i18n="d.home.downloadAnswer">打开作品详情，使用“下载原图”查看原始图片，同时核对来源、署名和授权备注。图片可下载不代表可以任意转载或商用。</p>
            <a class="guide-link" href="/about.html#license" data-i18n="d.home.license">阅读授权说明</a>
          </details>
        </div>
        <div class="share-strip">
          <p data-i18n="d.home.shareInvite">如果觉得好用，就把站点分享给其他人吧～</p>
          <button class="share-btn" id="share" data-share-card="/index.html" type="button"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg><span data-i18n="d.home.shareCard">分享卡片</span></button>
        </div>
      </section>
    </main>
  </div>
</div>
