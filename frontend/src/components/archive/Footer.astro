  <nav>
    <a href="/about.html#license" data-i18n="d.rights">来源与授权</a>
    <a href="/projects.html" data-i18n="d.friendsTitle">友情链接</a>
    <a href="/changelog.html" data-i18n="footer.changelog">更新日志</a>
    <a href="/community.html" data-i18n="v2.nav.community">社群</a>
    <RepositoryLinks />
  </nav>
