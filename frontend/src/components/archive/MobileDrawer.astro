---
import { archiveContext } from "../../lib/archive.mjs";
import { mobileNavigation } from './nav-items.mjs';
import {navigationCountPlaceholder} from '../library/navigation-count.mjs';
const { active = "" } = Astro.props;
const { icon, works } = archiveContext;
const isPage = item => active === item.id || (active === 'projects' && item.id === 'friendWall');
const isSection = item => !isPage(item) && item.id === 'browse' && ['characters', 'topics'].includes(active);
---
<aside class="sidebar mobile-drawer" id="sidebar">
  <a class="brand" href="/">
    <img src="/avatar.png" width="43" height="43" alt="蓝色大肥鱼" data-i18n-attr="alt:d.brandName" />
    <span><strong data-i18n="d.brandName">蓝色大肥鱼</strong><small data-i18n="d.brandSub">AI 娘二创开放档案</small></span>
  </a>
  <button class="mobile-close icon-button" type="button" data-menu-close aria-label="关闭菜单" data-i18n-attr="aria-label:v2.closeMenu"><Fragment set:html={icon('close')} /></button>
  <div class="nav-heading">
    <p class="nav-label" data-i18n="d.explore">逛一逛</p>
  </div>
  <nav class="main-nav primary-nav drawer-nav" aria-label="站点导航" data-i18n-attr="aria-label:v2.siteNav">
    {mobileNavigation.map(item => <a class:list={['nav-link',{'is-active':isPage(item) || isSection(item)}]} href={item.href} title={item.label} aria-label={item.label} data-i18n-attr={`title:${item.key},aria-label:${item.key}`} data-project-nav={['communityProjects','friendWall'].includes(item.id) ? item.id : undefined} aria-current={isPage(item) ? 'page' : isSection(item) ? 'true' : undefined}>
      <Fragment set:html={icon(item.icon)} /><span data-i18n={item.key}>{item.label}</span>
      {item.id === 'browse' && <small data-library-work-total>{import.meta.env.DEV ? works.length : navigationCountPlaceholder}</small>}
    </a>)}
  </nav>
  <div class="sidebar-bottom">
    <a href="/saved.html" title="我的收藏" data-i18n-attr="title:d.savedTitle"><Fragment set:html={icon('heart',18)} /><span data-i18n="d.savedTitle">我的收藏</span></a>
    <a href="https://github.com/lmy414/bluedafeiyu" target="_blank" rel="noopener noreferrer" title="站点源码" data-i18n-attr="title:footer.site"><Fragment set:html={icon('github',18)} /><span data-i18n="footer.site">站点源码</span></a>
    <p class="copyright" data-i18n="d.nonOfficial">非官方同人整理项目</p>
  </div>
</aside>
