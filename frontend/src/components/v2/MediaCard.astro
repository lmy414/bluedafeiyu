---
// 瀑布流作品卡：点击由 v2.js 接管为作品浮层；无 JS 时进入 /works/<slug>.html
import { LICENSE, fmtSize, fmtDate } from '../../lib/v2.mjs';
const { w, noChar = false } = Astro.props;
const [licShort, licFull] = LICENSE[w.lic];
---
<article class="media-card" style={'--c:' + w.char.color + ';--cs:' + w.char.soft} data-k={w.cats.join(' ')}>
  <a href={'/works/' + w.slug + '.html'} data-work={w.slug}>
    <div class="ph" style={w.width && w.height ? 'aspect-ratio:' + w.width + '/' + w.height : undefined}>
      <img loading="lazy" decoding="async" src={w.thumb} alt={w.description || w.name} width={w.width || undefined} height={w.height || undefined} />
      <span class="lic" data-lic={w.lic} title={licFull} data-i18n={'v2.licenseShort.' + w.lic} data-i18n-attr={'title:license.' + w.lic}>{licShort}</span>
      <span class="badge">{w.cats.length ? w.cats.map((id, i) => <Fragment>{i ? ' · ' : ''}<span data-i18n={'v2.type.' + id}>{id === 'meme' ? '梗图' : id === 'illustration' ? '插画' : id === 'setting' ? '设定' : '漫画'}</span></Fragment>) : <span data-i18n="v2.work">作品</span>}</span>
      {w.fileSize ? <span class="dl">↓ {fmtSize(w.fileSize)}</span> : null}
    </div>
    <div class="meta"><h3>{w.name}</h3><p>{noChar ? null : <span class="who"><i></i>{w.char.name}</span>}<span>{fmtDate(w.createdAt)}</span></p><p class="work-stats" data-work-stats={w.id} data-i18n-tpl="stats.counts" data-i18n-vars={JSON.stringify({views:'—',downloads:'—'})}>浏览 — · 下载 —</p></div>
  </a>
</article>
