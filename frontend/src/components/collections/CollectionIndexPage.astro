---
import V2Meta from '../v2/V2Meta.astro';
import HomeBody from '../home/HomeBody.astro';
import CollectionIndexBody from './CollectionIndexBody.astro';
import {archivePages} from '../../lib/archive.mjs';
import theme from '../../../public/theme.js?raw';
import runtime from '../../../public/components/runtime.js?raw';
import '../home/HomePage.css';
import './CollectionIndex.css';
const {kind}=Astro.props;
const path=`/${kind}.html`;
const {meta}=archivePages.get(path);
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<V2Meta title={meta.title} desc={meta.description} {path} og={meta.og} robots={meta.robots} canonical={meta.canonical} />
<link rel="icon" href="/favicon.png" />
<link rel="describedby" href="/llms.txt" type="text/plain" />
<link rel="alternate" href={path+'.md'} type="text/markdown" title="简体中文 Markdown" />
<script is:inline set:html={theme}></script>
<script is:inline set:html={runtime}></script>
<script is:inline src="/archive-labels.js?v=20261031-1" defer></script>
<script is:inline src="/archive-copy.js?v=20261031-1" defer></script>
<script is:inline src="/lang.js?v=25" defer></script>
<script is:inline src="/analytics.js" defer></script>
{meta.schemas.map(schema=><script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />)}
</head>
<body class="home-page collection-index-page archive refined" data-archive data-archive-count={meta.total} data-page={kind} data-i18n-page={kind==='serials'?'browse':'topics'}>
<a class="collection-skip-link" href="#main" data-i18n="v2.skip">跳到正文</a>
<HomeBody activePage={kind}><CollectionIndexBody {kind} /></HomeBody>
<script is:inline src="/components/home-controls.js" defer></script>
<script src="../characters/CharacterLanguageControls.js"></script>
</body>
</html>
