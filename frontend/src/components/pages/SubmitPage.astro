---
import V2 from '../../layouts/Archive.astro';
import { SITE } from '../../lib/v2.mjs';
import DocumentPage from '../archive/DocumentPage.astro';
import SubmissionForm from '../SubmissionForm.astro';
import CreatorRegistration from '../CreatorRegistration.astro';
import PageHeading from '../archive/PageHeading.astro';
---
<V2 title="AI娘表情包投稿 - 站内快速投稿与 GitHub 表单 | 蓝色大肥鱼" desc="提交 AI 娘表情包，上传图片、填写名称、角色和作品类型并选择是否署名；署名时填写名字，个人主页链接和说明可选。站内快速投稿与 GitHub 表单均可，作品类型会在审核时核对，来源与授权由维护者补齐。" path="/submit.html" active="submit" bodyPage="submit" pageStyles={["/page-styles/submit.css?v=2"]} robots="noindex,follow">
<DocumentPage>

    <PageHeading title="投稿" titleKey="submit.h1" description="把你的 AI 娘二创表情包交给我们归档。本页支持单张图片或 ZIP 图片集，也可以走 GitHub 表单；填写图片或图集名称、角色和作品类型，并选择是否署名，说明可选。图片逐张审核，通过后批量发布。" descriptionKey="submit.lede" />

    <nav class="submission-media-tabs section-tabs" role="tablist" aria-label="投稿方式" data-i18n-attr="aria-label:d.design.submissionMode">
      <button type="button" role="tab" id="image-submission-tab" data-submission-mode="image" aria-controls="image-submission-panel" aria-selected="true" data-i18n="d.design.imageSubmit">图片作品投稿</button>
      <button type="button" role="tab" id="video-submission-tab" data-submission-mode="video" aria-controls="creator-registration" aria-selected="false" data-i18n="d.creatorTitle">视频创作者登记</button>
    </nav>
    <section id="image-submission-panel" role="tabpanel" aria-labelledby="image-submission-tab">
      <div class="live-submit-layout"><div class="panel form-sheet"><SubmissionForm /></div><aside class="live-submit-guide"><h2 data-i18n="submit.guide.title">投稿指南</h2><p data-i18n="submit.note2">投稿先进入审核队列，审核通过后批量发布。维护者会核对作品类型，并补充标签、来源和授权信息。</p><p data-i18n="submit.format.b">原图单张 ≤ 10 MiB；ZIP ≤ 32 MiB、最多 100 张，包内单图 ≤ 16 MiB、解压总量 ≤ 64 MiB。请上传原图。</p><a class="button" href={SITE.repoContent + '/issues/new?template=sticker-submission.yml'} target="_blank" rel="noopener noreferrer" data-i18n="submit.channel.github">GitHub 投稿表单</a><a class="button" href="/about.html#license" data-i18n="work.licenseTitle">授权说明</a><a class="button" href="/community.html" data-i18n="v2.joinGroup">加入社群</a></aside></div>
    </section>
    <CreatorRegistration />
</DocumentPage>
<Fragment slot="scripts">
    <script is:inline src="/page-scripts/submit-0.js?v=12" async></script>
    <script is:inline src="/page-scripts/creator-registration.js?v=3" defer></script>
</Fragment>
</V2>
