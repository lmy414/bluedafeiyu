<section class="hero panel" aria-labelledby="hero-title">
      <span class="tape-strip" aria-hidden="true"></span>
      <div class="hero-body">
        <h1 class="hero-title" id="hero-title">蓝色<span class="marker-highlight">大肥鱼</span></h1>
        <p class="hero-subtitle" data-i18n="brand.tagline">AI 娘表情包开放档案</p>
        <p class="hero-lede" data-i18n="index.hero.lede">收集与下载 AI 娘二创表情包，按角色归档、按 Tag 检索。</p>
        <div class="hero-actions">
          <a class="btn primary hover-wiggle" href="#gallery">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 6.5 L8 10.5 L12 6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <span data-i18n="index.cta.browse">开始浏览</span>
          </a>
          <a class="btn hover-wiggle" href="submit.html">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.5 V12.5 M3.5 8 H12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
            <span data-i18n="index.cta.submit">提交作品</span>
          </a>
          <button type="button" class="btn hover-wiggle" id="btn-qq-group" aria-haspopup="dialog" aria-controls="qq-modal">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 3.5 H13.5 V10.5 H8 L5.5 13 V10.5 H2.5 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
            <span data-i18n="index.cta.group">加入交流群</span>
          </button>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <!-- 装饰性照片墙（父容器 aria-hidden）：统一 1:1 占位盒，与 .polaroid img 的 aspect-ratio:1 一致；
             fetchpriority=low 让位给首屏第一张真实作品图（fetchpriority=high）。 -->
        <div class="hero-collage">
          <div class="polaroid"><span class="tape-strip"></span><img src="owner-picks/previews/blue-maid.webp" alt="" width="480" height="480" decoding="async" fetchpriority="low" /></div>
