          <div class="polaroid"><span class="tape-strip"></span><img src="submissions/previews/claude/issue-08-001.webp" alt="" width="480" height="480" decoding="async" fetchpriority="low" /></div>
          <div class="polaroid"><span class="tape-strip"></span><img src="submissions/previews/qwen/issue-16-001.webp" alt="" width="480" height="480" decoding="async" fetchpriority="low" /></div>
          <div class="polaroid"><span class="tape-strip"></span><img src="submissions/previews/stepfun/issue-19-001.webp" alt="" width="480" height="480" decoding="async" fetchpriority="low" /></div>
