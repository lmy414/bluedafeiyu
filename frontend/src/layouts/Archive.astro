---
import V2Meta from '../components/v2/V2Meta.astro';
import Navigation from '../components/archive/Navigation.astro';
import Header from '../components/archive/Header.astro';
import Footer from '../components/archive/Footer.astro';
import MobileNav from '../components/archive/MobileNav.astro';
import PreviewDialog from '../components/archive/PreviewDialog.astro';
import TopicDownloadDialog from '../components/archive/TopicDownloadDialog.astro';
import GroupDialog from '../components/archive/GroupDialog.astro';
import { hasAiMarkdown } from '../../scripts/ai-content.mjs';
import '../styles/archive.css';
import themeScript from '../../public/theme.js?raw';
const { title, desc, path = '/', active = '', bodyPage = active, og, type = 'website', shareDesc = '',
  robots = 'index,follow', canonical = '', pageStyles = [], bodyAttrs = {}, schemas = [] } = Astro.props;
const refined=!['/browse.html','/videos.html'].includes(path) && !path.startsWith('/categories/');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <V2Meta {title} {desc} {path} {og} {type} {shareDesc} {robots} {canonical} />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    {hasAiMarkdown(path) && <link rel="alternate" href={path + '.md'} type="text/markdown" title="简体中文 Markdown" />}
    <link rel="icon" href="/favicon.png" />
    <script is:inline set:html={themeScript}></script>
    {pageStyles.map(href => <link rel="stylesheet" {href} />)}
    <script is:inline src="/archive-labels.js?v=8" defer></script>
    <script is:inline src="/archive-copy.js?v=20261023-3" defer></script>
    <script is:inline src="/lang.js?v=22" defer></script>
    <script is:inline src="/analytics.js" defer></script>
    {schemas.map(schema => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body class:list={['archive','sidebar-collapsed', {refined,'journal-home':active==='home'}]} data-design-version="20261023-3" data-archive data-i18n-page={bodyPage} data-page={active} {...bodyAttrs}>
    <a class="skip-link" href="#main" data-i18n="v2.skip">跳到正文</a>
    <Navigation {active} />
    <div class="menu-scrim" data-menu-close hidden></div>
    <div class="main-wrap">
      <Header {active} />
      <main id="main">
        <slot />
        <Footer />
      </main>
      <MobileNav {active} />
    </div>
    <PreviewDialog />
    <TopicDownloadDialog />
    <GroupDialog />
    <script is:inline src="/work-stats.js?v=20261023-3" defer></script>
    <script src="../scripts/archive-entry.js"></script>
    <script is:inline src="/archive/filter-select.js?v=2" defer></script>


    <slot name="scripts" />
    <script src="../scripts/demo-production.js"></script>
  </body>
</html>
