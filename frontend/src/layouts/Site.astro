---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AppleTouchIcons from '../components/AppleTouchIcons.astro';
const {active='',bodyPage,rootPath='',categoryId}=Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <AppleTouchIcons />
  <slot name="head" />
</head>
<body data-i18n-page={bodyPage} data-category-id={categoryId}>
  <SiteHeader active={active} rootPath={rootPath} />
  <main class="page"><slot /></main>
  <slot name="after-main" />
  <SiteFooter rootPath={rootPath} />
  <slot name="scripts" />
</body>
</html>
