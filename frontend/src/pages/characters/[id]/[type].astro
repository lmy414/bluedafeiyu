---
import ArchivePage from "../../../components/archive/ArchivePage.astro";
import { archivePages } from "../../../lib/archive.mjs";
export function getStaticPaths() {
 return [...archivePages].flatMap(([url,page])=>{const match=url.match(/^\/characters\/([^\/]+)\/((?!page$)[^\/]+)\.html$/);return match?[{params:{id: match[1], type: match[2]},props:{page}}]:[];});
}
const {page}=Astro.props;
---
<ArchivePage page={page} />
