{
  "name": "bluedafeiyu-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @dafeiyu/api dev",
    "dev:web": "pnpm --filter @dafeiyu/web dev",
    "dev:admin": "pnpm --filter @dafeiyu/admin dev",
    "build": "pnpm --filter @dafeiyu/shared build && pnpm --filter @dafeiyu/api build && pnpm --filter @dafeiyu/admin build && pnpm --filter @dafeiyu/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @dafeiyu/api db:generate",
    "db:migrate": "pnpm --filter @dafeiyu/api db:migrate"
  }
}
