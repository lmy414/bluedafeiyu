# ops/hermes/hermes.env.example —— Hermes 侧定时任务的私有环境变量模板
#
# 用法：复制成 Hermes 私有的环境文件（例如容器里的 /etc/hermes/hermes.env 或
# Hermes 应用的「环境变量」配置），权限 0600，不要提交、不要写进仓库。
# 这里只有变量名与占位值，没有任何真实端点、令牌或服务器路径。
#
# 默认安全姿态：三个真实开关都是 false。脚本默认 dry-run，只读待审列表与原图，
# 不发模型请求、不写队列、不触发发布。要真实执行，必须「命令行 --live」
# 加「对应开关 = true」同时满足。
#
# server 端另外还有一套开关（AUTO_PUBLISH_ENABLED / PUBLISH_PUSH_ENABLED /
# PUBLISH_DEPLOY_ENABLED），在服务器自己的 /etc/dafeiyu/publish.env 里，不在本文件。

# ---------------------------------------------------------------- 内部审核口（公开口）
# 内部审核走公开口，不是管理口。默认 127.0.0.1:8790；只绑回环时，Hermes 要与 server 同机
# 或经 SSH 隧道访问。
HERMES_REVIEW_API_URL=http://127.0.0.1:8790
# Hermes 专属令牌，对应 server 的 SUBMISSION_HERMES_REVIEW_TOKEN。
# 与 astrbot 令牌、管理令牌都不同；轮换时两边一起换。
HERMES_REVIEW_TOKEN=REPLACE_WITH_HERMES_REVIEW_TOKEN
# 内部待审来源，默认 web,github-issue（QQ 不在其中，Hermes 不处理 QQ）。
HERMES_REVIEW_SOURCES=web,github-issue

# ---------------------------------------------------------------- 管理口（仅 pull-issues 用）
# POST /api/v1/pull-issues 在管理口，用管理令牌；管理口只绑回环。
HERMES_ADMIN_API_URL=http://127.0.0.1:8788
HERMES_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN

# ---------------------------------------------------------------- 视觉模型（OpenAI 兼容 vision）
# 不配这两个，review-cycle --live 会直接报错，不会假造结论。
HERMES_VISION_ENDPOINT=https://example.invalid/v1/chat/completions
HERMES_VISION_API_KEY=REPLACE_WITH_VISION_KEY
HERMES_VISION_MODEL=
HERMES_VISION_TIMEOUT_MS=60000

# ---------------------------------------------------------------- 审核行为
# 置信度门槛；低于它的结论转人工。与内容侧 PUBLISH_MIN_CONFIDENCE 保持一致。
HERMES_REVIEW_MIN_CONFIDENCE=0.6
# 提示词版本标记，随批次透传给 server 做审计；改了提示词就升一位。
HERMES_REVIEW_PROMPT_VERSION=hermes-review-v1

# ---------------------------------------------------------------- 真实动作开关（默认全关）
# 必须同时给命令行 --live 和这里的 true，才允许真实动作。缺一个都不执行。
HERMES_REVIEW_LIVE=false
HERMES_PULL_LIVE=false
HERMES_PUBLISH_LIVE=false

# ---------------------------------------------------------------- 运行状态
# 本地锁与游标的存放目录；只需一个可写目录，不放任何权威状态。
HERMES_STATE_DIR=/var/lib/hermes-dafeiyu
HERMES_LOCK_STALE_MS=900000
HERMES_HTTP_TIMEOUT_MS=30000

# ---------------------------------------------------------------- GitHub 拉取（每天 2–3 次）
# 默认走管理口 POST /api/v1/pull-issues。
# 需要 --max-pages 或 since 游标时，改用 SSH 调 server/cli.mjs。
HERMES_PULL_SSH=
HERMES_PULL_CMD=node server/cli.mjs pull-issues --state open --max-pages 5

# ---------------------------------------------------------------- 批量发布（每 6 小时）
# 默认在服务器侧执行 publish-batch；复用发布根时建议直接用 systemd 单元，
# 这样会带上它的 /etc/dafeiyu/publish.env 与三重开关。
HERMES_PUBLISH_SSH=
HERMES_PUBLISH_CMD=node ops/publish-batch.mjs --live
HERMES_PUBLISH_DRY_CMD=node ops/publish-batch.mjs --dry-run
# SSH 与 publish 命令的执行目录（服务器上的站点仓工作树）。
HERMES_SERVER_DIR=
