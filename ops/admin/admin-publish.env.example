# ops/admin/admin-publish.env.example
#
# 复制到服务器上的 /etc/dafeiyu/admin-publish.env，权限 0600。
# 这里只保留变量名和占位值，不放真实令牌、域名或服务器路径。

# 后台 HTTP 接口与执行器令牌。
ADMIN_API_URL=http://127.0.0.1:3100
ADMIN_WORKER_TOKEN=REPLACE_WITH_ADMIN_WORKER_TOKEN
ADMIN_PUBLISH_REQUEST_DIR=/srv/apps/dafeiyu-admin/run

# 投稿服务管理口：执行器按 submissionId 临时读取原图，校验后直接写入内容仓。
SUBMISSION_ADMIN_API_URL=http://127.0.0.1:8788
SUBMISSION_ADMIN_TOKEN=REPLACE_WITH_SUBMISSION_ADMIN_TOKEN

# 两个公开 Git 工作树与共享发布锁目录。
PUBLISH_SITE_DIR=/srv/www/dafeiyu/bluedafeiyu
PUBLISH_CONTENT_DIR=/srv/www/dafeiyu/content
INTAKE_ROOT=/srv/www/dafeiyu/dafeiyu-intake
PUBLISH_REMOTE=origin
PUBLISH_BRANCH=main

# 工具链。服务器需安装 Node 22、git，以及带 Pillow 的 python3。
PUBLISH_NODE=/usr/bin/node
PUBLISH_PYTHON=python3
# 执行器始终做一次完整构建校验；该变量保留给兼容旧批处理脚本。
PUBLISH_BUILD_CHECK=true
PUBLISH_GIT_NAME=dafeiyu-publish-bot
PUBLISH_GIT_EMAIL=dafeiyu-publish-bot@users.noreply.github.com

# 发布部署。runDeploy 会复制 ops/deploy-server.sh 到该目录后执行。
PUBLISH_DEPLOY_ROOT=/srv/www/dafeiyu

# deploy-server.sh 变量。环境变量优先于脚本自己的配置文件。
DEPLOY_ROOT=/srv/www/dafeiyu
REPO_URL=https://github.com/example/bluedafeiyu.git
BRANCH=main
HEALTH_URL=https://example.invalid
CONTENT_REPO_URL=https://github.com/example/ai-girl-stickers.git
CONTENT_BRANCH=main
CONTENT_DIR=/srv/www/dafeiyu/content
SHARED_DATA_DIR=/srv/www/dafeiyu/shared/data
PRECOMPRESS=1
