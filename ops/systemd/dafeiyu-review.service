[Unit]
Description=蓝色大肥鱼即时 AI 审核
After=dafeiyu-submission.service

[Service]
Type=oneshot
User=dafeiyu
Group=dafeiyu
WorkingDirectory=/srv/www/dafeiyu/source
EnvironmentFile=/etc/dafeiyu/submission.env
ExecStart=/usr/bin/flock -n -E 0 /run/lock/dafeiyu-review.lock /usr/bin/node server/cli.mjs review-received --limit 50
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/www/dafeiyu/submission-private /srv/www/dafeiyu/dafeiyu-intake
