# ops/publish-batch.env.example —— 自动批量发布的私有环境变量模板
#
# 用法：复制成服务器上的私有文件（例如 /etc/dafeiyu/publish.env），权限 0600，
# 由 systemd 的 EnvironmentFile 注入；**不要提交、不要写进仓库**。
# 这里只有变量名与占位值，没有任何真实凭据、域名或服务器路径。
#
# 默认安全姿态：不做任何真实改动。要真正发布，必须同时打开
#   AUTO_PUBLISH_ENABLED=true      （总开关：允许写两个工作树并本地提交）
#   PUBLISH_PUSH_ENABLED=true      （允许 git push）
#   PUBLISH_DEPLOY_ENABLED=true    （允许调用 ops/deploy-server.sh）
# 三者齐备且部署健康检查通过，才把中转条目置为 published。缺任一个都不会标记已发布。

# ---------------------------------------------------------------- 路径（必填）
# 站点源码仓工作树：本仓库（含 ops/、tools/、data/）。
SOURCE_DIR=/srv/www/dafeiyu/bluedafeiyu
# 站点仓库根（脚本读 data/ 清单、写 data/works.json）。默认等于 SOURCE_DIR。
PUBLISH_SITE_DIR=/srv/www/dafeiyu/bluedafeiyu
# 内容仓工作树：图片（原图 / 派生图）与投稿 Issue 模板。
PUBLISH_CONTENT_DIR=/srv/www/dafeiyu/content
# 私有收录中转区：必须在两个公开仓之外、且不在任何 git 工作树内。
INTAKE_ROOT=/srv/www/dafeiyu/dafeiyu-intake

# ---------------------------------------------------------------- 总开关（默认关闭）
# 只读演练不需要改这里：默认就是 dry-run。
AUTO_PUBLISH_ENABLED=false
PUBLISH_PUSH_ENABLED=false
PUBLISH_DEPLOY_ENABLED=false

# ---------------------------------------------------------------- 分支与远程
PUBLISH_REMOTE=origin
PUBLISH_BRANCH=main

# ---------------------------------------------------------------- 工具链
# 服务器需要 node >= 18、git，以及带 Pillow 的 python3（跑派生图）。
PUBLISH_NODE=/usr/bin/node
PUBLISH_PYTHON=python3
# 提交前在临时目录再跑一次完整构建校验（默认 true，强烈建议保持）。
PUBLISH_BUILD_CHECK=true

# ---------------------------------------------------------------- 记录生成
# 原图 Raw 基址：新记录 path 字段 = 该基址 + 内容仓里的相对路径。不要带结尾斜杠。
PUBLISH_ORIGINAL_BASE_URL=https://raw.githubusercontent.com/lmy414/ai-girl-stickers/main
# AI 置信度门槛：低于它就留在 ready（与 server/ 的初审门槛保持一致）。
PUBLISH_MIN_CONFIDENCE=0.6
# 本次批次最多处理多少条 ready（0 或留空 = 不限制）。
PUBLISH_MAX_ENTRIES=0
PUBLISH_GIT_NAME=dafeiyu-publish-bot
PUBLISH_GIT_EMAIL=dafeiyu-publish-bot@users.noreply.github.com
# 发布锁陈旧阈值（毫秒）。进程被杀后超过它自动回收锁。
PUBLISH_LOCK_STALE_MS=21600000

# ---------------------------------------------------------------- 部署（PUBLISH_DEPLOY_ENABLED=true 时必填其一）
# 推荐：指向发布根，脚本会把 ops/deploy-server.sh 复制成发布根下的副本再执行
# （避免部署脚本 reset --hard 时替换掉正在运行的文件）。
PUBLISH_DEPLOY_ROOT=/srv/www/dafeiyu
# 或者直接给一条自定义部署命令（用 bash -lc 执行）；二者给一个即可。
# PUBLISH_DEPLOY_CMD=/srv/www/dafeiyu/.deploy-runner.sh
# 或者直接指定副本路径。
# PUBLISH_DEPLOY_RUNNER=/srv/www/dafeiyu/.publish-deploy-runner.sh

# deploy-server.sh 需要的变量（与 ops/deploy-server.sh 同一套；环境变量优先于 DEPLOY_ENV 文件）。
DEPLOY_ROOT=/srv/www/dafeiyu
REPO_URL=https://github.com/lmy414/bluedafeiyu.git
BRANCH=main
HEALTH_URL=https://example.invalid
CONTENT_REPO_URL=https://github.com/lmy414/ai-girl-stickers.git
CONTENT_BRANCH=main
CONTENT_DIR=/srv/www/dafeiyu/content
SHARED_DATA_DIR=/srv/www/dafeiyu/shared/data
# 可选：部署脚本的配置文件路径。
# DEPLOY_ENV=/etc/dafeiyu/deploy.env
