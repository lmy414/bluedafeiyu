---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubmitWidget from './SubmitWidget.astro';
import { api } from '../lib/api';
import { copy, tr, type Locale } from '../lib/i18n';
interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const rawMode = Astro.url.searchParams.get('mode');
const mode = rawMode === 'zip' || rawMode === 'creator' ? rawMode : 'single';
const [characters, categories] = mode !== 'creator' ? await Promise.all([api.characters(locale), api.categories(locale)]) : [];
const title = tr(locale, 'submit');
const seoTitle = copy(locale, ['投稿 AI 娘二创作品：来源与授权填写指南 · 蓝色大肥鱼', 'Submit AI-girl fan art: sources and permissions · Blue Dafeiyu', 'AI娘の二次創作を投稿：出典と利用許諾 · 藍色大肥魚']);
const description = copy(locale, ['了解 AI 娘图片投稿需要填写的角色、作品类型、原始来源、署名和授权信息。站内投稿和 GitHub 表单均会进入审核队列。', 'Learn what to include in a fan art submission: character, artwork type, original source, credit and permissions. Both web and GitHub submissions enter the review queue.', 'AI娘の画像を投稿する際のキャラクター、作品の種類、元の出典、クレジット、利用許諾について。サイトとGitHubからの投稿は審査を行います。']);
---

<BaseLayout {locale} {path} {title} {seoTitle} {description} noindex>
  <header class="console-page-head submit-heading"><div><h1 class="page-title">{title}</h1><p>{mode === 'creator'
    ? copy(locale, ['登记哔哩哔哩账号，方便收录你的 AI 娘二创视频。', 'Register your Bilibili profile to have your AI-girl fan videos considered for the archive.', 'Bilibiliアカウントを登録し、AI娘の二次創作動画をアーカイブに掲載しましょう。'])
    : copy(locale, ['提交 AI 娘二创原图，并补充角色、来源与授权信息。', 'Submit original AI-girl fan art and add its characters, source and permissions.', 'AI娘の二次創作の原画に、キャラクター、出典、利用許諾の情報を添えて投稿できます。'])}</p></div></header>
  <SubmitWidget {locale} {mode} characters={characters?.items ?? []} categories={categories?.items ?? []} />
</BaseLayout>
