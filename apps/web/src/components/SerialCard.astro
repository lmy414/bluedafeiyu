---
import Icon from './Icon.astro';
import { field, publicUrl, workMedia, type Topic } from '../lib/api';
import { htmlLang, localizedText, localePath, tr, type Locale } from '../lib/i18n';
import { readerPath, topicPath } from '../lib/site';

interface Props { topic: Topic; locale: Locale }
const { topic, locale } = Astro.props;
const title = field(locale, topic, 'name');
const description = field(locale, topic, 'summary');
const author = localizedText(locale, topic.author?.name);
const pages = topic.reader?.totalPages ?? topic.readerConfig?.totalPages ?? topic.pages?.at(-1)?.pageNumber ?? 0;
const cover = topic.coverWork ?? topic.cover;
const media = cover && workMedia(cover);
const image = publicUrl(topic.coverUrl) || media?.thumb;
const href = localePath(locale, topicPath(topic.id));
const readingHref = pages > 0 ? localePath(locale, readerPath(topic.id, 1)) : href;
const cta = tr(locale, pages > 0 ? 'startRead' : 'detail');
---

<article class="serial-card directory-card">
  {image ? <img class="directory-media directory-image serial-cover" src={image} alt="" width={media?.thumbWidth} height={media?.thumbHeight} loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <div class="directory-media serial-cover"><Icon name="serials" /></div>}
  <div class="serial-card-copy">
    <header>
      <h2><a href={href}>{title}</a></h2>
      {author && <p>{tr(locale, 'creator')} · {author}</p>}
    </header>
    {description && <p class="serial-summary">{description}</p>}
    <div class="serial-card-actions">
      {pages > 0 && <span class="serial-page-count mono">{new Intl.NumberFormat(htmlLang[locale]).format(pages)} {tr(locale, 'pageCount')}</span>}
      <a class="console-btn console-btn-primary" href={readingHref}>{cta}<span class="visually-hidden"> · {title}</span><Icon name="arrowRight" /></a>
    </div>
  </div>
</article>
