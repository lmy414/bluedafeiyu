---
import LinkCard from './LinkCard.astro';
import Icon from './Icon.astro';
import { copy, tr, type Locale } from '../lib/i18n';
import { contentRepository, sourceRepository } from '../lib/site';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const repositories = [
  { href: sourceRepository, title: tr(locale, 'siteRepo'), description: copy(locale, ['前台、结构化清单与构建发布工具。', 'The frontend, structured catalogs and build tools.', 'フロントエンド、構造化データ、公開ツール。']), note: 'lmy414/bluedafeiyu', icon: 'fileText' },
  { href: contentRepository, title: tr(locale, 'contentRepo'), description: copy(locale, ['投稿原图、派生图与 GitHub 投稿表单。', 'Original submissions, image derivatives and GitHub submission forms.', '投稿元画像、派生画像、GitHub投稿フォーム。']), note: 'lmy414/ai-girl-stickers', icon: 'gallery' },
] as const;
---
{compact ? <nav class="explore-repositories" aria-label={tr(locale, 'repoHeading')}>
  {repositories.map(({ href, title, description, note }) => <a class="filter-pill" {href} title={description} target="_blank" rel="noopener noreferrer"><span class="explore-repository-copy"><span>{title}</span><span class="mono">{note}</span></span><Icon name="externalLink" /></a>)}
</nav> : <div class="archive-grid archive-grid-two">
  {repositories.map(repository => <LinkCard {...repository} external />)}
</div>}
